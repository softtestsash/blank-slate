{
  "expo": {
    "name": "Blank Slate",
    "slug": "blank-slate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "blankslate",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blankslate.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Blank Slate uses Bluetooth to connect to your smart scale.",
        "NSBluetoothPeripheralUsageDescription": "Blank Slate uses Bluetooth to connect to your smart scale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blankslate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow Blank Slate to connect to your scale"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1420de2e-235f-48f6-9f69-b6a43a05b12f"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
